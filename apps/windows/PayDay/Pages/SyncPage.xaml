<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="PayDay.Pages.SyncPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:PayDay.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <conv:BoolToVisibilityConverter x:Key="Visible" />
        <conv:BoolToVisibilityConverter x:Key="Hidden" Invert="True" />
        <Style x:Key="SyncCard" TargetType="Border">
            <Setter Property="Padding" Value="20" />
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>
        <Style x:Key="SyncNote" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel
            MaxWidth="860"
            Padding="24,16,24,24"
            HorizontalAlignment="Left"
            Spacing="16">

            <!-- Title -->
            <StackPanel Spacing="2">
                <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Sync" />
                <TextBlock Style="{StaticResource SyncNote}" Text="Keep your bills and payments the same on every device. Your data is encrypted on this PC before it is uploaded: OneDrive only stores files it cannot read." />
            </StackPanel>

            <!-- Busy, errors and notes -->
            <StackPanel
                Orientation="Horizontal"
                Spacing="10"
                Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource Visible}}">
                <ProgressRing
                    Width="18"
                    Height="18"
                    AutomationProperties.Name="Working"
                    IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
                <TextBlock
                    VerticalAlignment="Center"
                    AutomationProperties.LiveSetting="Polite"
                    Text="{x:Bind ViewModel.BusyMessage, Mode=OneWay}"
                    TextWrapping="Wrap" />
            </StackPanel>
            <InfoBar
                Title="Something needs attention"
                AutomationProperties.LiveSetting="Assertive"
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                Severity="Error" />
            <InfoBar
                AutomationProperties.LiveSetting="Polite"
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.HasInfo, Mode=OneWay}"
                Message="{x:Bind ViewModel.InfoMessage, Mode=OneWay}"
                Severity="Informational" />

            <!-- Not configured -->
            <Border Style="{StaticResource SyncCard}" Visibility="{x:Bind ViewModel.IsNotConfigured, Mode=OneWay, Converter={StaticResource Visible}}">
                <StackPanel Spacing="6">
                    <TextBlock FontWeight="SemiBold" Text="{x:Bind ViewModel.NotConfiguredMessage}" />
                    <TextBlock Style="{StaticResource SyncNote}" Text="This copy of FutureCheck has no OneDrive app registration, so it cannot sign in. Everything else works as usual on this PC." />
                </StackPanel>
            </Border>

            <!-- Off -->
            <Border Style="{StaticResource SyncCard}" Visibility="{x:Bind ViewModel.IsOff, Mode=OneWay, Converter={StaticResource Visible}}">
                <StackPanel Spacing="12">
                    <StackPanel Spacing="4">
                        <TextBlock FontWeight="SemiBold" Text="Sync is off" />
                        <TextBlock Style="{StaticResource SyncNote}" Text="Turning sync on signs in to OneDrive. If you don't use sync yet, this PC's data becomes your synced data (a backup is saved first). If you already sync another device, you join it with your recovery phrase or a pairing code." />
                    </StackPanel>
                    <Button
                        AutomationProperties.Name="Turn on sync"
                        Click="OnTurnOnClick"
                        Content="Turn on sync"
                        IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}"
                        Style="{ThemeResource AccentButtonStyle}" />
                </StackPanel>
            </Border>

            <!-- Create -->
            <Border Style="{StaticResource SyncCard}" Visibility="{x:Bind ViewModel.IsCreate, Mode=OneWay, Converter={StaticResource Visible}}">
                <StackPanel Spacing="12">
                    <TextBlock FontWeight="SemiBold" Text="Start syncing from this PC" />
                    <TextBlock Style="{StaticResource SyncNote}" Text="There is no FutureCheck vault on this OneDrive account yet. Creating one:" />
                    <StackPanel Margin="8,0,0,0" Spacing="4">
                        <TextBlock Style="{StaticResource SyncNote}" Text="• saves a backup of this PC's data first (kept, never rotated away);" />
                        <TextBlock Style="{StaticResource SyncNote}" Text="• encrypts this PC's bills, payments, snapshots and synced settings and uploads them to the app's own OneDrive folder;" />
                        <TextBlock Style="{StaticResource SyncNote}" Text="• shows a 24-word recovery phrase once. Losing every device and the phrase loses the synced data." />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button
                            AutomationProperties.Name="Create my vault"
                            Click="OnCreateVaultClick"
                            Content="Create my vault"
                            IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}"
                            Style="{ThemeResource AccentButtonStyle}" />
                        <Button
                            AutomationProperties.Name="Cancel creating a vault"
                            Click="OnCancelClick"
                            Content="Cancel"
                            IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Join -->
            <Border Style="{StaticResource SyncCard}" Visibility="{x:Bind ViewModel.IsJoin, Mode=OneWay, Converter={StaticResource Visible}}">
                <StackPanel Spacing="14">
                    <StackPanel Spacing="4">
                        <TextBlock FontWeight="SemiBold" Text="Join your vault" />
                        <TextBlock Style="{StaticResource SyncNote}" Text="Your OneDrive already has a FutureCheck vault. Unlock it with your recovery phrase, or with the pairing code another device shows under Sync, Add a device." />
                    </StackPanel>
                    <TextBox
                        Height="96"
                        AcceptsReturn="True"
                        AutomationProperties.Name="Recovery phrase, 24 words"
                        Header="Recovery phrase (24 words)"
                        IsSpellCheckEnabled="False"
                        IsTextPredictionEnabled="False"
                        Text="{x:Bind ViewModel.PhraseInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        TextWrapping="Wrap" />
                    <Button
                        AutomationProperties.Name="Join with recovery phrase"
                        Click="OnJoinWithPhraseClick"
                        Content="Join with recovery phrase"
                        IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}"
                        Style="{ThemeResource AccentButtonStyle}" />
                    <TextBox
                        AutomationProperties.Name="Pairing code"
                        Header="Or a pairing code (FCPAIR:1:…)"
                        IsSpellCheckEnabled="False"
                        IsTextPredictionEnabled="False"
                        Text="{x:Bind ViewModel.PairingCodeInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <Button
                        AutomationProperties.Name="Join with pairing code"
                        Click="OnJoinWithCodeClick"
                        Content="Join with pairing code"
                        IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}" />
                    <Button
                        AutomationProperties.Name="Cancel joining"
                        Click="OnCancelClick"
                        Content="Cancel"
                        IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}" />
                </StackPanel>
            </Border>

            <!-- Blocked -->
            <Border Style="{StaticResource SyncCard}" Visibility="{x:Bind ViewModel.IsBlocked, Mode=OneWay, Converter={StaticResource Visible}}">
                <StackPanel Spacing="12">
                    <TextBlock FontWeight="SemiBold" Text="Some rows must be fixed first" />
                    <TextBlock Style="{StaticResource SyncNote}" Text="Sync could not be turned on because these rows can't be converted. Nothing was changed and no backup was written. Fix them (or restore an older backup) and try again." />
                    <ItemsControl AutomationProperties.Name="Rows to fix" ItemsSource="{x:Bind ViewModel.BlockingRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <TextBlock
                                    Margin="0,2"
                                    IsTextSelectionEnabled="True"
                                    Text="{x:Bind}"
                                    TextWrapping="Wrap" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button
                        AutomationProperties.Name="Back"
                        Click="OnCancelClick"
                        Content="Back" />
                </StackPanel>
            </Border>

            <!-- Recovery phrase -->
            <Border Style="{StaticResource SyncCard}" Visibility="{x:Bind ViewModel.IsRecoveryPhrase, Mode=OneWay, Converter={StaticResource Visible}}">
                <StackPanel Spacing="12">
                    <TextBlock FontWeight="SemiBold" Text="Save your recovery phrase" />
                    <TextBlock Style="{StaticResource SyncNote}" Text="{x:Bind ViewModel.RecoveryPhraseNote, Mode=OneWay}" />
                    <TextBlock TextWrapping="Wrap" Text="These 24 words are the key to your synced data. You need them to add a device without a pairing code, or if this PC's key is lost. They are shown only now. Anyone with these words and access to your OneDrive can read your data, and if you lose every device and the words, the synced data is gone. Write them down or save them somewhere private." />
                    <ItemsRepeater AutomationProperties.Name="Recovery phrase words" ItemsSource="{x:Bind ViewModel.RecoveryWords}">
                        <ItemsRepeater.Layout>
                            <UniformGridLayout
                                ItemsStretch="Fill"
                                MinColumnSpacing="12"
                                MinItemWidth="150"
                                MinRowSpacing="8" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <TextBlock
                                    FontFamily="Consolas"
                                    FontSize="15"
                                    IsTextSelectionEnabled="True"
                                    Text="{x:Bind}" />
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                    <Button
                        AutomationProperties.Name="Save the recovery phrase to a file"
                        Click="OnSavePhraseClick"
                        Content="Save to a file…" />
                    <CheckBox
                        x:Name="PhraseSavedBox"
                        AutomationProperties.Name="I saved my recovery phrase somewhere safe"
                        Click="OnPhraseSavedClick"
                        Content="I saved my recovery phrase somewhere safe" />
                    <Button
                        AutomationProperties.Name="Done, I saved the recovery phrase"
                        Click="OnFinishPhraseClick"
                        Content="Done"
                        IsEnabled="{x:Bind ViewModel.CanFinishRecoveryPhrase, Mode=OneWay}"
                        Style="{ThemeResource AccentButtonStyle}" />
                </StackPanel>
            </Border>

            <!-- Status -->
            <Border Style="{StaticResource SyncCard}" Visibility="{x:Bind ViewModel.IsStatus, Mode=OneWay, Converter={StaticResource Visible}}">
                <StackPanel Spacing="14">
                    <StackPanel Spacing="4">
                        <TextBlock
                            AutomationProperties.HeadingLevel="Level2"
                            AutomationProperties.LiveSetting="Polite"
                            FontSize="18"
                            FontWeight="SemiBold"
                            Text="{x:Bind ViewModel.StatusTitle, Mode=OneWay}" />
                        <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" TextWrapping="Wrap" />
                        <TextBlock Style="{StaticResource SyncNote}" Text="{x:Bind ViewModel.LastSyncedText, Mode=OneWay}" />
                        <TextBlock Style="{StaticResource SyncNote}" Text="{x:Bind ViewModel.PendingText, Mode=OneWay}" />
                        <TextBlock Style="{StaticResource SyncNote}" Text="{x:Bind ViewModel.AccountText, Mode=OneWay}" />
                    </StackPanel>

                    <!-- Warnings: an icon plus words, never colour alone -->
                    <StackPanel Spacing="6" Visibility="{x:Bind ViewModel.HasWarnings, Mode=OneWay, Converter={StaticResource Visible}}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon AutomationProperties.AccessibilityView="Raw" FontSize="14" Glyph="&#xE7BA;" />
                            <TextBlock FontWeight="SemiBold" Text="Warnings" />
                        </StackPanel>
                        <ItemsControl AutomationProperties.Name="Sync warnings" ItemsSource="{x:Bind ViewModel.Warnings}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <TextBlock
                                        Margin="0,2"
                                        Text="{x:Bind}"
                                        TextWrapping="Wrap" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- Notion connector owner -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="{x:Bind ViewModel.NotionLine, Mode=OneWay}" TextWrapping="Wrap" />
                        <Button
                            AutomationProperties.Name="Run Notion on this PC"
                            Click="OnRunNotionHereClick"
                            Content="Run Notion on this PC"
                            IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.CanRunNotionHere, Mode=OneWay, Converter={StaticResource Visible}}" />
                    </StackPanel>

                    <!-- Locked -->
                    <StackPanel Spacing="10" Visibility="{x:Bind ViewModel.NeedsUnlock, Mode=OneWay, Converter={StaticResource Visible}}">
                        <TextBlock Style="{StaticResource SyncNote}" Text="Enter your recovery phrase, or a pairing code from another device, to unlock sync on this PC. Your data on this PC stays as it is." />
                        <TextBox
                            Height="96"
                            AcceptsReturn="True"
                            AutomationProperties.Name="Recovery phrase to unlock, 24 words"
                            Header="Recovery phrase (24 words)"
                            IsSpellCheckEnabled="False"
                            IsTextPredictionEnabled="False"
                            Text="{x:Bind ViewModel.PhraseInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            TextWrapping="Wrap" />
                        <Button
                            AutomationProperties.Name="Unlock with recovery phrase"
                            Click="OnUnlockWithPhraseClick"
                            Content="Unlock with recovery phrase"
                            IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}"
                            Style="{ThemeResource AccentButtonStyle}" />
                        <TextBox
                            AutomationProperties.Name="Pairing code to unlock"
                            Header="Or a pairing code"
                            IsSpellCheckEnabled="False"
                            IsTextPredictionEnabled="False"
                            Text="{x:Bind ViewModel.PairingCodeInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <Button
                            AutomationProperties.Name="Unlock with pairing code"
                            Click="OnUnlockWithCodeClick"
                            Content="Unlock with pairing code"
                            IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}" />
                    </StackPanel>

                    <!-- Recovery actions -->
                    <Button
                        AutomationProperties.Name="Join again"
                        Click="OnRejoinClick"
                        Content="Join again"
                        IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}"
                        Style="{ThemeResource AccentButtonStyle}"
                        ToolTipService.ToolTip="Join the vault again under a new identity. This PC's data is backed up first."
                        Visibility="{x:Bind ViewModel.NeedsRejoin, Mode=OneWay, Converter={StaticResource Visible}}" />
                    <Button
                        AutomationProperties.Name="Sign in to OneDrive again"
                        Click="OnSignInAgainClick"
                        Content="Sign in again"
                        IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}"
                        Style="{ThemeResource AccentButtonStyle}"
                        Visibility="{x:Bind ViewModel.NeedsSignIn, Mode=OneWay, Converter={StaticResource Visible}}" />
                    <Button
                        AutomationProperties.Name="Create a new vault from this PC"
                        Click="OnStartNewVaultClick"
                        Content="Create a new vault from this PC"
                        IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.CanCreateNewVault, Mode=OneWay, Converter={StaticResource Visible}}" />

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button
                            AutomationProperties.Name="Sync now"
                            Click="OnSyncNowClick"
                            Content="Sync now"
                            IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}" />
                        <Button
                            AutomationProperties.Name="Add a device"
                            Click="OnAddDeviceClick"
                            Content="Add a device"
                            IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}" />
                        <Button
                            AutomationProperties.Name="Turn off sync"
                            Click="OnTurnOffClick"
                            Content="Turn off sync"
                            IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Pairing -->
            <Border Style="{StaticResource SyncCard}" Visibility="{x:Bind ViewModel.IsPairing, Mode=OneWay, Converter={StaticResource Visible}}">
                <StackPanel Spacing="12">
                    <TextBlock FontWeight="SemiBold" Text="Add a device" />
                    <TextBlock Style="{StaticResource SyncNote}" Text="On the new device, sign in to the same OneDrive account, choose Turn on sync, then scan this code (or type the code below). Show it only while pairing, don't screenshot or photograph it, and pair only on a OneDrive account that is yours alone." />
                    <Image
                        x:Name="QrImage"
                        Width="270"
                        Height="270"
                        HorizontalAlignment="Left"
                        AutomationProperties.Name="Pairing QR code. Scan it on the new device, or show the code as text below."
                        Stretch="Uniform" />
                    <TextBlock
                        AutomationProperties.LiveSetting="Off"
                        Text="{x:Bind ViewModel.PairingCountdownText, Mode=OneWay}" />
                    <ToggleSwitch
                        AutomationProperties.Name="Show the pairing code as text"
                        Header="Show the code as text (for a PC without a camera)"
                        IsOn="{x:Bind ViewModel.ShowPairingCodeText, Mode=TwoWay}" />
                    <TextBox
                        AutomationProperties.Name="Pairing code text"
                        FontFamily="Consolas"
                        IsReadOnly="True"
                        Text="{x:Bind ViewModel.PairingCodeText, Mode=OneWay}"
                        TextWrapping="Wrap"
                        Visibility="{x:Bind ViewModel.ShowPairingCodeText, Mode=OneWay, Converter={StaticResource Visible}}" />
                    <Button
                        AutomationProperties.Name="Done, close the pairing code"
                        Click="OnClosePairingClick"
                        Content="Done" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
