<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>PayDay</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PayDay.Tests" />
  </ItemGroup>

  <!-- The BIP39 English wordlist for the recovery phrase (spec/sync-protocol.md section 8), embedded
       unchanged from spec/ (the one copy in the repository; its SHA-256 is checked at load and in a test). -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\..\spec\bip39-english.txt" LogicalName="PayDay.Sync.Crypto.bip39-english.txt" Link="Sync\Crypto\bip39-english.txt" />
  </ItemGroup>

</Project>
