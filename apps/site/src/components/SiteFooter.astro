---
import { siteConfig } from "../site.config";
import Container from "./Container.astro";
import SmartLink from "./SmartLink.astro";
---

<footer class="border-t border-border bg-surface">
  <Container class="grid gap-10 py-12 sm:grid-cols-2 lg:grid-cols-4">
    <div>
      <p class="font-semibold">{siteConfig.name}</p>
      <p class="mt-2 text-sm text-muted">{siteConfig.tagline}</p>
    </div>
    {
      siteConfig.footer.map((group) => (
        <nav aria-label={group.title}>
          <p class="text-sm font-semibold">{group.title}</p>
          <ul class="mt-3 space-y-2 text-sm text-muted">
            {group.links.map((link) => (
              <li>
                <SmartLink link={link} class="hover:text-fg" />
              </li>
            ))}
          </ul>
        </nav>
      ))
    }
  </Container>
  <Container class="border-t border-border py-6 text-xs text-muted">
    <p>
      {siteConfig.name} keeps your data on your devices. No accounts, no servers, no tracking.
    </p>
  </Container>
</footer>
