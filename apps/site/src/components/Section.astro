---
/**
 * A landing-page section with an anchor id, so the header nav can link to it. Put the intro copy in
 * the "intro" slot and the section body in the default slot.
 */
import Container from "./Container.astro";

type Props = {
  id: string;
  eyebrow?: string;
  title: string;
  tone?: "default" | "surface";
};

const { id, eyebrow, title, tone = "default" } = Astro.props;
const headingId = `${id}-heading`;
const hasIntro = Astro.slots.has("intro");
const hasBody = Astro.slots.has("default");
---

<section
  id={id}
  aria-labelledby={headingId}
  class:list={["py-20", { "bg-surface": tone === "surface" }]}
>
  <Container>
    <div class="max-w-2xl">
      {
        eyebrow && (
          <p class="text-sm font-semibold tracking-wide text-accent uppercase">{eyebrow}</p>
        )
      }
      <h2 id={headingId} class="mt-2 text-3xl font-semibold tracking-tight sm:text-4xl">
        {title}
      </h2>
      {
        hasIntro && (
          <div class="mt-4 text-lg text-muted">
            <slot name="intro" />
          </div>
        )
      }
    </div>
    {
      hasBody && (
        <div class="mt-10">
          <slot />
        </div>
      )
    }
  </Container>
</section>
