---
/**
 * Typography for rendered Markdown (such as PRIVACY.md). The Markdown elements come from another
 * component, so the selectors are :global() and scoped under this wrapper's class instead.
 */
type Props = {
  class?: string;
};

const { class: className } = Astro.props;
---

<div class:list={["prose", className]}>
  <slot />
</div>

<style>
  @reference "../styles/global.css";

  .prose :global(h1) {
    @apply text-4xl font-semibold tracking-tight sm:text-5xl;
  }
  .prose :global(h2) {
    @apply mt-12 text-2xl font-semibold tracking-tight;
  }
  .prose :global(h3) {
    @apply mt-8 text-xl font-semibold;
  }
  .prose :global(p) {
    @apply mt-4 leading-7;
  }
  .prose :global(ul) {
    @apply mt-4 list-disc space-y-2 pl-6 leading-7;
  }
  .prose :global(ol) {
    @apply mt-4 list-decimal space-y-2 pl-6 leading-7;
  }
  .prose :global(li > ul),
  .prose :global(li > ol) {
    @apply mt-2;
  }
  .prose :global(strong) {
    @apply font-semibold;
  }
  .prose :global(code) {
    @apply rounded-sm bg-surface px-1.5 py-0.5 font-mono text-[0.9em];
  }
  .prose :global(a) {
    @apply text-accent underline underline-offset-4;
  }
</style>
