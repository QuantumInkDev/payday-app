---
// Built to dist/404.html, which Vercel serves for any unknown path. No canonical URL, and noindex.
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Page not found" canonicalPath={null} indexing="noindex">
  <section class="not-found" aria-labelledby="not-found-title">
    <div class="zone">
      <p class="code">404</p>
      <h1 id="not-found-title">Page not found.</h1>
      <p class="lead">That page doesn't exist, or it has moved.</p>
      <svg viewBox="0 0 230 45" aria-hidden="true" focusable="false">
        <path
          d="M4 34h72c38 0 30-23 67-23h81"
          stroke="currentColor"
          stroke-width="3"
          stroke-linecap="round"
          fill="none"></path>
        <circle cx="222" cy="11" r="6" fill="var(--fc-accent)" stroke="currentColor" stroke-width="2"
        ></circle>
      </svg>
      <a class="action" href="/">Back to the home page</a>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found {
    padding-block: 96px 112px;
  }

  .code {
    color: var(--fc-text-muted);
    font-size: 15px;
  }

  h1 {
    margin-top: 12px;
    font-size: var(--fc-text-h2);
  }

  .lead {
    max-width: 40ch;
    margin-top: 20px;
    font-size: 20px;
    line-height: 1.55;
  }

  svg {
    display: block;
    width: min(230px, 100%);
    height: 45px;
    margin-block: 36px 32px;
  }

  @media (max-width: 50rem) {
    .not-found {
      padding-block: 56px 72px;
    }

    .lead {
      font-size: 17px;
    }
  }
</style>
