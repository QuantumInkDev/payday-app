---
// The privacy policy's single source of truth is PRIVACY.md at the repository root. Astro renders
// it at build time; edit the policy there, not here. (apps/site/turbo.json lists it as a build
// input, so a policy change rebuilds the site.)
//
// The rendered policy is split at its first section heading: the H1, effective date and
// introduction go in the title band, and the sections go on the reading surface. The text itself
// is never rewritten.
import * as policy from "../../../../PRIVACY.md";
import LegalPage from "../components/LegalPage.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { siteConfig } from "../site.config";

const html = await policy.compiledContent();
const firstSection = html.search(/<h2[\s>]/);
const introHtml = firstSection === -1 ? html : html.slice(0, firstSection);
const sectionsHtml = firstSection === -1 ? "" : html.slice(firstSection);
const contents = policy
  .getHeadings()
  .filter((heading) => heading.depth === 2)
  .map(({ slug, text }) => ({ slug, text }));
---

<BaseLayout
  title="Privacy policy"
  description={`How ${siteConfig.name} handles your data: stored on your device, optional end-to-end encrypted sync through your own cloud drive, and no analytics or tracking.`}
  canonicalPath="/privacy"
>
  <LegalPage contents={contents}>
    <Fragment slot="intro" set:html={introHtml} />
    <Fragment set:html={sectionsHtml} />
  </LegalPage>
</BaseLayout>
