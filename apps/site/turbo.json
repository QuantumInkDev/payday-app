{
  "$schema": "https://turborepo.com/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/PRIVACY.md"],
      "outputs": ["dist/**"],
      "env": [
        "SITE_URL",
        "PUBLIC_SITE_URL",
        "VERCEL_ENV",
        "VERCEL_PROJECT_PRODUCTION_URL",
        "VERCEL_URL"
      ]
    }
  }
}
