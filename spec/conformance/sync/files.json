    {
      "name": "change file name for seq 1",
      "input": {
        "fn": "changeFileName",
        "seq": 1
      },
      "expected": {
        "name": "000001.chg"
      }
    },
    {
      "name": "change file name for seq 42",
      "input": {
        "fn": "changeFileName",
        "seq": 42
      },
      "expected": {
        "name": "000042.chg"
      }
    },
    {
      "name": "change file name for seq 999999",
