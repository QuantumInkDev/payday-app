    {
      "name": "valid change file envelope",
      "input": {
        "fn": "checkEnvelope",
        "payload": {
          "type": "changes",
          "formatVersion": 1,
          "vaultId": "019a0000-0000-7000-8000-00000000fa01",
          "deviceId": "0a0a0a0a0a0a0a0a",
          "seq": 3,
          "records": [
            {
              "entity": "bill",
              "id": "019a0000-0000-7000-8000-0000000000b1",
              "field": "deleted",
              "value": false,
              "hlc": "01a1d9edc200-0000-0a0a0a0a0a0a0a0a"
            },
            {
              "entity": "bill",
              "id": "019a0000-0000-7000-8000-0000000000b1",
              "field": "name",
              "value": "Woodgrove Rewards",
              "hlc": "01a1d9edc200-0000-0a0a0a0a0a0a0a0a"
            },
            {
              "entity": "bill",
              "id": "019a0000-0000-7000-8000-0000000000b1",
              "field": "payment",
              "value": 55.0,
              "hlc": "01a1d9edc200-0000-0a0a0a0a0a0a0a0a"
            },
            {
              "entity": "bill",
              "id": "019a0000-0000-7000-8000-0000000000b1",
              "field": "remainingCheckpoint",
              "value": 1200.0,
              "hlc": "01a1d9edc200-0000-0a0a0a0a0a0a0a0a"
            },
            {
              "entity": "bill",
              "id": "019a0000-0000-7000-8000-0000000000b1",
              "field": "type",
              "value": "Cards",
              "hlc": "01a1d9edc200-0000-0a0a0a0a0a0a0a0a"
            }
          ]
        },
        "path": "devices/0a0a0a0a0a0a0a0a/000003.chg",
        "vaultId": "019a0000-0000-7000-8000-00000000fa01"
      },
      "expected": {
        "ignoredRecords": []
      }
    },
