      "note": "Neither kept snapshot covers C up to 8."
    },
    {
      "name": "nothing is deleted while the newest snapshot is too young",
      "input": {
        "fn": "deletableSnapshots",
        "snapshots": [
          {
            "hlc": "01a1d9ef48a0-0000-0a0a0a0a0a0a0a0a",
            "covers": {
              "0a0a0a0a0a0a0a0a": 3
            },
            "ageOk": true
          },
          {
            "hlc": "01a1d9f0cf40-0000-0a0a0a0a0a0a0a0a",
            "covers": {
              "0a0a0a0a0a0a0a0a": 5
            },
            "ageOk": true
          },
          {
            "hlc": "01a1d9f255e0-0000-0b0b0b0b0b0b0b0b",
            "covers": {
              "0a0a0a0a0a0a0a0a": 6
            },
            "ageOk": false
          }
        ]
      },
      "expected": {
        "deletable": []
      }
    },
    {
      "name": "concurrent snapshots resolved by a later dominating one",
      "input": {
        "fn": "deletableSnapshots",
        "snapshots": [
          {
            "hlc": "01a1d9f6c2b0-0000-0b0b0b0b0b0b0b0b",
            "covers": {
              "0a0a0a0a0a0a0a0a": 12,
              "0b0b0b0b0b0b0b0b": 10
            },
            "ageOk": true
          },
          {
            "hlc": "01a1d9f6e9c0-0000-0a0a0a0a0a0a0a0a",
            "covers": {
              "0a0a0a0a0a0a0a0a": 20,
              "0b0b0b0b0b0b0b0b": 5
            },
            "ageOk": true
          },
          {
            "hlc": "01a1d9f87060-0000-0c0c0c0c0c0c0c0c",
            "covers": {
              "0a0a0a0a0a0a0a0a": 20,
              "0b0b0b0b0b0b0b0b": 12
            },
            "ageOk": true
          }
