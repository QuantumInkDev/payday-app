            "label": "This Pay Period",
            "key": "2025-05-15",
            "start": "2025-05-15",
            "end": "2025-05-28",
            "bills": []
          },
          {
            "label": "Next Pay Period",
            "key": "2025-05-29",
            "start": "2025-05-29",
            "end": "2025-06-11",
            "bills": []
          },
          {
            "label": "Following Period",
            "key": "2025-06-12",
            "start": "2025-06-12",
            "end": "2025-06-25",
            "bills": []
          }
        ]
      }
    },
