        "snapshots": [],
        "settings": {}
      },
      "expected": {
        "document": {
          "formatVersion": 1,
          "exportedAt": "2025-05-15T12:00:00.0000000Z",
          "bills": [],
          "payments": [],
          "snapshots": [],
          "settings": {}
        }
      }
    },
