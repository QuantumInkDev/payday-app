      "input": {
        "anchor": "2025-03-20",
        "now": "2025-03-20T00:00:00"
      },
      "expected": {
        "periods": [
          {
            "label": "This Pay Period",
            "key": "2025-03-20",
            "start": "2025-03-20",
            "end": "2025-04-02",
            "payday": "2025-03-20",
            "isCurrent": true
