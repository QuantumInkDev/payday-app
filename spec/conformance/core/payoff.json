        "remaining": 1000.0,
        "payment": 20.01,
        "apr": 24
      },
      "expected": {
        "months": 384
      }
    },
    {
      "name": "payment exactly equal to monthly interest never pays off",
      "input": {
        "kind": "estimate",
        "remaining": 1200.0,
        "payment": 12.0,
        "apr": 12
      },
      "expected": {
        "months": "never"
      }
    },
    {
      "name": "payment below monthly interest never pays off",
      "input": {
        "kind": "estimate",
        "remaining": 1000.0,
        "payment": 15.0,
        "apr": 24
      },
      "expected": {
        "months": "never"
      }
    },
