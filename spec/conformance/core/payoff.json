{
  "version": 1,
  "description": "Payoff estimates and Payoff Tracker ordering. Two kinds of case; Bill shape and defaults are in README.md. kind 'estimate': input { kind, remaining, payment, apr (annual percent) } -> expected { months }. months is null when remaining <= 0 or payment <= 0; when apr <= 0 it is ceil(remaining / payment); otherwise with r = apr / 12 / 100 it is 'never' when payment <= remaining * r, else ceil(-ln(1 - remaining * r / payment) / ln(1 + r)). All arithmetic is IEEE double, so a quotient like 120.48 / 10.04 = 12.000000000000002 rounds up to 13. kind 'tracker': input { kind, bills: [Bill] }. Included bills: active and remaining > 0. expected { itemCount, totalRemaining, items: [ { id, months (as above, from remaining/payment/apr), hasLimit (creditLimit > 0), limitUsedFraction (hasLimit ? remaining / creditLimit clamped to 0..1 : 0) } ] in input order, order: { payoffTime, snowball, avalanche } each a list of ids }. payoffTime: bills with a month count first by months ascending, then 'never', then null; ties by name. snowball: remaining ascending, ties by name. avalanche: apr descending, then remaining ascending, then name. Name comparison is ordinal and case-insensitive; names that still tie keep input order. The reference computes months only; it has no payoff calendar date (see README.md).",
  "cases": [
    {
      "name": "no APR, divides evenly",
      "input": {
        "kind": "estimate",
        "remaining": 1000.0,
        "payment": 100.0,
        "apr": 0
      },
      "expected": {
        "months": 10
      }
    },
    {
      "name": "no APR, rounds up a partial month",
      "input": {
        "kind": "estimate",
        "remaining": 1050.0,
        "payment": 100.0,
        "apr": 0
      },
      "expected": {
        "months": 11
      }
    },
    {
      "name": "no APR, payment larger than the balance",
      "input": {
        "kind": "estimate",
        "remaining": 80.0,
        "payment": 100.0,
        "apr": 0
      },
      "expected": {
        "months": 1
      }
    },
    {
      "name": "no APR, payment equal to the balance",
      "input": {
        "kind": "estimate",
        "remaining": 100.0,
        "payment": 100.0,
        "apr": 0
      },
      "expected": {
        "months": 1
      }
    },
    {
      "name": "no APR, float quotient just above an integer rounds up",
      "input": {
        "kind": "estimate",
        "remaining": 120.48,
        "payment": 10.04,
        "apr": 0
      },
      "expected": {
        "months": 13
      }
    },
    {
      "name": "no APR, float quotient just below an integer",
      "input": {
        "kind": "estimate",
        "remaining": 0.3,
        "payment": 0.1,
        "apr": 0
      },
      "expected": {
        "months": 3
      }
    },
    {
      "name": "negative APR is treated as no APR",
      "input": {
        "kind": "estimate",
        "remaining": 1000.0,
        "payment": 100.0,
        "apr": -5
      },
      "expected": {
        "months": 10
      }
    },
    {
      "name": "12% APR amortises",
      "input": {
        "kind": "estimate",
        "remaining": 1000.0,
        "payment": 100.0,
        "apr": 12
      },
      "expected": {
        "months": 11
      }
    },
    {
      "name": "24.99% APR on a card balance",
      "input": {
        "kind": "estimate",
        "remaining": 2500.0,
        "payment": 75.0,
        "apr": 24.99
      },
      "expected": {
        "months": 58
      }
    },
